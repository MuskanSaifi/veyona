# Add inside your nginx server { } block for veyona.in (fixes 413 on admin image uploads)
#
# sudo nano /etc/nginx/sites-available/veyona
# Then: sudo nginx -t && sudo systemctl reload nginx

client_max_body_size 20M;

# Optional: increase timeouts for slow uploads
client_body_timeout 120s;
proxy_read_timeout 120s;
proxy_connect_timeout 120s;
proxy_send_timeout 120s;
